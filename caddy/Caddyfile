{$PUBLIC_HOSTNAME:localhost} {
  encode gzip
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    Content-Security-Policy "default-src 'self'; connect-src 'self' wss://{$PUBLIC_HOSTNAME:localhost}; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
  }
  handle /api/* {
    reverse_proxy api:8000
  }
  handle {
    root * /srv/dashboard
    try_files {path} /index.html
    file_server
  }
}
