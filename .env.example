# AuthSphere Environment Configuration

# Deployment Environment: dev | demo | prod
ENV=dev

# Public Hostnames
PUBLIC_HOSTNAME=auth.example.com
MQTT_PUBLIC_HOSTNAME=mqtt.example.com

# Database Settings
POSTGRES_USER=authsphere
POSTGRES_DB=authsphere
DATABASE_URL=postgresql+asyncpg://authsphere:authsphere_dev_pass@postgres:5432/authsphere

# Internal Broker Settings
MQTT_HOST=mosquitto
MQTT_PORT=8883

# Operational & Rotation Parameters
DEMO_MODE=false
DEMO_CERT_LIFETIME_SECONDS=120
ROTATION_CONFIRM_TIMEOUT_SECONDS=300
CLAIM_TOKEN_TTL_SECONDS=600
POP_MAX_SKEW_SECONDS=120
CHAT_INSPECTOR_ENABLED=false
TELEMETRY_RETENTION_HOURS=24

# Initial Dashboard Admin (seeded on first boot)
INITIAL_ADMIN_EMAIL=admin@authsphere.local
INITIAL_ADMIN_PASSWORD=AdminSecurePassword123!

# System Logging
LOG_LEVEL=INFO

# Secrets File Paths (Docker Secrets / local fallback)
INTERMEDIATE_KEY_FILE=/run/secrets/intermediate_key
SVC_API_KEY_FILE=/run/secrets/svc_api_key
SVC_BRIDGE_KEY_FILE=/run/secrets/svc_bridge_key
JWT_SECRET_FILE=/run/secrets/jwt_secret
FERNET_KEY_FILE=/run/secrets/fernet_key
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
DYNSEC_ADMIN_PASSWORD_FILE=/run/secrets/dynsec_admin_password
